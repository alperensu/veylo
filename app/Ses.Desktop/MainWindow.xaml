<Window x:Class="Ses.Desktop.MainWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SES" Width="1080" Height="840" MinWidth="640" MinHeight="420" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged" SizeChanged="WindowSizeChanged">
 <Grid Margin="28,20,28,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><Viewbox Margin="9"><Path Fill="#1A240D" Data="M 0,12 L 3,12 L 3,25 L 0,25 Z M 5,5 L 8,5 L 8,32 L 5,32 Z M 10,0 L 13,0 L 13,37 L 10,37 Z M 15,8 L 18,8 L 18,29 L 15,29 Z M 20,13 L 23,13 L 23,24 L 20,24 Z"/></Viewbox></Border>
    <StackPanel><TextBlock Text="SES" FontSize="22" FontWeight="Bold"/><TextBlock Text="{DynamicResource tagline}" Style="{StaticResource Caption}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource driverLink}" Click="DriverClick" Margin="0,0,12,0"/><ComboBox x:Name="LanguageBox" Width="76" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource language}"><ComboBoxItem Content="TR"/><ComboBoxItem Content="EN"/></ComboBox></StackPanel>
  </Grid>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
   <StackPanel>
    <TextBlock Text="{DynamicResource title}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="{DynamicResource intro}" Style="{StaticResource BodyMuted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
     <StackPanel>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="{DynamicResource devices}" Style="{StaticResource Caption}"/><Button Content="{DynamicResource refresh}" Click="RefreshClick" DockPanel.Dock="Right" HorizontalAlignment="Right" MinHeight="28" Padding="10,4"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{DynamicResource input}" Margin="0,0,0,7"/><ComboBox x:Name="InputBox" SelectionChanged="DeviceChanged" AutomationProperties.Name="{DynamicResource input}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource output}" Margin="0,0,0,7"/><ComboBox x:Name="OutputBox" SelectionChanged="DeviceChanged" AutomationProperties.Name="{DynamicResource output}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      </Grid>
      <TextBlock x:Name="RouteHint" Style="{StaticResource BodyMuted}" Margin="0,10,0,16"/>
      <DockPanel LastChildFill="False"><Button x:Name="StartButton" Content="{DynamicResource start}" Style="{StaticResource PrimaryButton}" Click="StartClick" MinWidth="178" Margin="0,0,18,0"/><CheckBox x:Name="MuteBox" Content="{DynamicResource mute}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,18,0"/><CheckBox x:Name="BypassBox" Content="{DynamicResource bypass}" ToolTip="{DynamicResource bypassTip}" Checked="SettingsToggled" Unchecked="SettingsToggled"/></DockPanel>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PresetColumn" Width="230"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource profiles}" Style="{StaticResource Caption}" Margin="0,2,0,8"/><TextBlock Text="{DynamicResource profileHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
      <ListBox x:Name="PresetList" SelectionChanged="PresetChanged" AutomationProperties.Name="{DynamicResource profiles}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="{Binding Description}" Style="{StaticResource BodyMuted}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBox x:Name="ProfileNameBox" MaxLength="64" Margin="0,4,0,8" AutomationProperties.Name="{DynamicResource profileName}"/>
      <Button Content="{DynamicResource save}" Click="SaveProfileClick" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource import}" Click="ImportClick" Padding="6,8"/><Button Grid.Column="2" Content="{DynamicResource export}" Click="ExportClick" Padding="6,8"/></Grid>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource levels}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
       <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource raw}" FontSize="12"/><ProgressBar x:Name="InputMeter" Grid.Column="1" Minimum="-60" Maximum="0" Value="-60" VerticalAlignment="Center"/><TextBlock x:Name="InputLevel" Grid.Column="2" Text="— dBFS" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"/></Grid>
       <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource processed}" FontSize="12"/><ProgressBar x:Name="OutputMeter" Grid.Column="1" Minimum="-60" Maximum="0" Value="-60" VerticalAlignment="Center"/><TextBlock x:Name="OutputLevel" Grid.Column="2" Text="— dBFS" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"/></Grid>
       <WrapPanel><TextBlock Text="{DynamicResource gain}" Style="{StaticResource Caption}" Margin="0,0,8,0"/><TextBlock x:Name="GainLevel" Text="0.0 dB" FontSize="12" Margin="0,0,18,0"/><TextBlock Text="{DynamicResource compression}" Style="{StaticResource Caption}" Margin="0,0,8,0"/><TextBlock x:Name="CompressionLevel" Text="0.0 dB" FontSize="12"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel>
       <DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource controls}" Style="{StaticResource Caption}"/><TextBlock x:Name="ModifiedLabel" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
       <CheckBox x:Name="NoiseBox" Content="{DynamicResource noise}" Checked="SettingsToggled" Unchecked="SettingsToggled"/>
       <DockPanel Margin="0,4,0,0"><TextBlock Text="{DynamicResource strength}" Style="{StaticResource BodyMuted}"/><TextBlock x:Name="NoiseValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
       <Slider x:Name="NoiseSlider" Minimum="0" Maximum="1" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource strength}"/>
       <CheckBox x:Name="BalanceBox" Content="{DynamicResource balance}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><DockPanel><TextBlock Text="{DynamicResource warmth}"/><TextBlock x:Name="WarmthValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></DockPanel><Slider x:Name="WarmthSlider" Minimum="-12" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource warmth}"/></StackPanel>
        <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="{DynamicResource clarity}"/><TextBlock x:Name="ClarityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></DockPanel><Slider x:Name="ClaritySlider" Minimum="-12" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource clarity}"/></StackPanel>
       </Grid>
       <TextBlock Text="{DynamicResource naturalHint}" Style="{StaticResource BodyMuted}" FontSize="11"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
    <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><Expander x:Name="AdvancedExpander" Header="{DynamicResource advanced}"><StackPanel Margin="0,14,0,0">
     <TextBlock Text="{DynamicResource eq}" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ItemsControl x:Name="BandsControl"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="86"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
      <ComboBox SelectedIndex="{Binding Type,Mode=TwoWay}" ItemsSource="{Binding ElementName=Root,Path=EqTypes}" SelectionChanged="BandTypeChanged" AutomationProperties.Name="EQ type" MinHeight="32"/>
      <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Frequency,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" LostFocus="BandFrequencyChanged" ToolTip="20–20000 Hz" AutomationProperties.Name="EQ frequency Hz"/>
      <TextBlock Grid.Column="2" Text="Hz" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0"/>
      <Grid Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions><Slider Minimum="-12" Maximum="12" Value="{Binding GainDb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ValueChanged="BandGainChanged" Margin="12,2" AutomationProperties.Name="EQ gain dB"/><TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Text="{Binding GainDb,StringFormat={}{0:+0.0;-0.0;0.0} dB}"/></Grid>
      <TextBox Grid.Column="4" Margin="8,0,0,0" Text="{Binding Q,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" LostFocus="BandFrequencyChanged" ToolTip="Q · 0.2–10" AutomationProperties.Name="EQ Q"/>
     </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <CheckBox x:Name="DeesserBox" Content="{DynamicResource deesser}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,4,0,12"/>
     <WrapPanel><StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource highpass}" FontSize="12"/><TextBlock x:Name="HighpassValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="HighpassSlider" Minimum="20" Maximum="300" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource highpass}" ToolTip="Hz"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource target}" FontSize="12"/><TextBlock x:Name="TargetValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="TargetSlider" Minimum="-36" Maximum="-10" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource target}" ToolTip="dBFS"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource minGain}" FontSize="12"/><TextBlock x:Name="MinGainValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="MinGainSlider" Minimum="-12" Maximum="0" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource minGain}" ToolTip="dB"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource maxGain}" FontSize="12"/><TextBlock x:Name="MaxGainValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="MaxGainSlider" Minimum="0" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource maxGain}" ToolTip="dB"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource threshold}" FontSize="12"/><TextBlock x:Name="ThresholdValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="ThresholdSlider" Minimum="-48" Maximum="-3" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource threshold}" ToolTip="dBFS"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource ratio}" FontSize="12"/><TextBlock x:Name="RatioValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="RatioSlider" Minimum="1" Maximum="8" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource ratio}" ToolTip=":1"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource attack}" FontSize="12"/><TextBlock x:Name="AttackValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="AttackSlider" Minimum="1" Maximum="100" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource attack}" ToolTip="ms"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource release}" FontSize="12"/><TextBlock x:Name="ReleaseValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="ReleaseSlider" Minimum="20" Maximum="1000" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource release}" ToolTip="ms"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource knee}" FontSize="12"/><TextBlock x:Name="KneeValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="KneeSlider" Minimum="0" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource knee}" ToolTip="dB"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource deessMax}" FontSize="12"/><TextBlock x:Name="DeessMaxValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="DeessMaxSlider" Minimum="0" Maximum="3" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource deessMax}" ToolTip="dB"/></StackPanel>
<StackPanel Margin="0,0,18,4" Width="255"><DockPanel><TextBlock Text="{DynamicResource outputGain}" FontSize="12"/><TextBlock x:Name="OutputGainValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="OutputGainSlider" Minimum="-24" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource outputGain}" ToolTip="dB"/></StackPanel></WrapPanel>
    </StackPanel></Expander></Border>
    <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel>
     <TextBlock Text="{DynamicResource test}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource testHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
     <WrapPanel><Button x:Name="RecordButton" Content="{DynamicResource record}" Click="RecordClick" Margin="0,0,8,8"/><Button x:Name="ListenRawButton" Content="{DynamicResource listenRaw}" Click="ListenRawClick" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="ListenProcessedButton" Content="{DynamicResource listenProcessed}" Click="ListenProcessedClick" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="ExportWaveButton" Content="{DynamicResource exportWave}" Click="ExportWaveClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
     <ProgressBar x:Name="SampleProgress" Minimum="0" Maximum="20" Value="0" Margin="0,6,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CalibrateButton" Content="{DynamicResource calibrate}" Click="CalibrateClick" Margin="0,0,14,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CalibrationMessage" Text="{DynamicResource ambientPrompt}" Style="{StaticResource BodyMuted}"/><TextBlock Text="{DynamicResource headphones}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Grid>
    </StackPanel></Border>
    <Expander Header="{DynamicResource preferences}" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0">
     <CheckBox x:Name="StartupBox" Content="{DynamicResource startup}" Checked="StartupChanged" Unchecked="StartupChanged"/>
     <WrapPanel Margin="0,10,0,0"><TextBlock Text="{DynamicResource muteKey}" VerticalAlignment="Center"/><ComboBox x:Name="MuteKeyBox" Width="65" Margin="6,0,16,0" AutomationProperties.Name="{DynamicResource muteKey}"/><TextBlock Text="{DynamicResource bypassKey}" VerticalAlignment="Center"/><ComboBox x:Name="BypassKeyBox" Width="65" Margin="6,0,16,0" AutomationProperties.Name="{DynamicResource bypassKey}"/><Button Content="{DynamicResource applyKeys}" Click="ApplyKeysClick"/></WrapPanel>
    </StackPanel></Expander>
    <TextBlock x:Name="DiagnosticsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{DynamicResource ready}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/><TextBlock Grid.Column="1" Text="{DynamicResource privacy}" Style="{StaticResource Caption}" Margin="16,0,0,0"/></Grid></Border>
 </Grid>
</Window>

