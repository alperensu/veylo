       <Button Content="{DynamicResource preset_natural}" Tag="0" Click="QuickPresetClick" Margin="0,0,8,8" />
       <Button Content="{DynamicResource preset_clear}" Tag="1" Click="QuickPresetClick" Margin="0,0,8,8" />
       <Button Content="{DynamicResource preset_warm}" Tag="2" Click="QuickPresetClick" Margin="0,0,8,8" />
       <Button Content="{DynamicResource preset_broadcast}" Tag="3" Click="QuickPresetClick" Margin="0,0,8,8" />
       <Button Content="{DynamicResource preset_podcast}" Tag="4" Click="QuickPresetClick" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock Text="{DynamicResource qualityPresetHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,18" />
      <TextBlock Text="{DynamicResource toneTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock Text="{DynamicResource toneHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,18" />
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="18" />
        <ColumnDefinition />
       </Grid.ColumnDefinitions>
       <StackPanel>
        <DockPanel>
         <TextBlock Text="{DynamicResource warmth}" />
         <TextBlock x:Name="WarmthValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
        <Slider x:Name="WarmthSlider" Minimum="-12" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource warmth}" />
       </StackPanel>
       <StackPanel Grid.Column="2">
        <DockPanel>
         <TextBlock Text="{DynamicResource clarity}" />
         <TextBlock x:Name="ClarityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
        <Slider x:Name="ClaritySlider" Minimum="-12" Maximum="12" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource clarity}" />
       </StackPanel>
      </Grid>
      <TextBlock Text="{DynamicResource clarityHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,18" />
      <CheckBox x:Name="DeesserBox" Content="{DynamicResource deesser}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource deesserHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,18" />
      <WrapPanel>
       <StackPanel Margin="0,0,18,4" Width="255">
        <DockPanel>
         <TextBlock Text="{DynamicResource highpass}" FontSize="12" />
         <TextBlock x:Name="HighpassValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
        </DockPanel>
        <Slider x:Name="HighpassSlider" Minimum="20" Maximum="300" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource highpass}" ToolTip="Hz" />
       </StackPanel>
       <StackPanel Margin="0,0,18,4" Width="255">
        <DockPanel>
         <TextBlock Text="{DynamicResource deessMax}" FontSize="12" />
         <TextBlock x:Name="DeessMaxValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
        </DockPanel>
        <Slider x:Name="DeessMaxSlider" Minimum="0" Maximum="3" ValueChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource deessMax}" ToolTip="dB" />
       </StackPanel>
      </WrapPanel>
      <Border Style="{StaticResource Panel}" Margin="0,18,0,0">
       <Expander x:Name="AdvancedExpander" Header="{DynamicResource advanced}">
        <StackPanel Margin="0,14,0,0">
         <TextBlock Text="{DynamicResource eq}" FontWeight="SemiBold" Margin="0,0,0,12" />
         <ItemsControl x:Name="BandsControl">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Grid Margin="0,0,0,12">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118" />
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="68" />
             </Grid.ColumnDefinitions>
             <ComboBox SelectedIndex="{Binding Type,Mode=TwoWay}" ItemsSource="{Binding ElementName=Root,Path=EqTypes}" SelectionChanged="BandTypeChanged" AutomationProperties.Name="{DynamicResource eqTypeName}" MinHeight="32" />
             <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Frequency,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" LostFocus="BandFrequencyChanged" ToolTip="20–20000 Hz" AutomationProperties.Name="{DynamicResource eqFrequencyName}" />
             <TextBlock Grid.Column="2" Text="Hz" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
             <Grid Grid.Column="3">
              <Grid.ColumnDefinitions>
               <ColumnDefinition />
               <ColumnDefinition Width="56" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="-12" Maximum="12" Value="{Binding GainDb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ValueChanged="BandGainChanged" Margin="12,2" AutomationProperties.Name="{DynamicResource eqGainName}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Text="{Binding GainDb,StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
             </Grid>
             <TextBox Grid.Column="4" Margin="8,0,0,0" Text="{Binding Q,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" LostFocus="BandFrequencyChanged" ToolTip="Q · 0.2–10" AutomationProperties.Name="{DynamicResource eqQName}" />
            </Grid>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Expander>
      </Border>
     </StackPanel>
     <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
      <StackPanel MaxWidth="680">
       <TextBlock Text="{DynamicResource profiles}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
       <TextBlock Text="{DynamicResource profileHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14" />
       <ListBox x:Name="PresetList" SelectionChanged="PresetChanged" AutomationProperties.Name="{DynamicResource profiles}">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
           <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMuted}" FontSize="12" />
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBox x:Name="ProfileNameBox" MaxLength="64" Margin="0,4,0,8" AutomationProperties.Name="{DynamicResource profileName}" />
       <Button Content="{DynamicResource save}" Click="SaveProfileClick" Margin="0,0,0,8" />
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition />
         <ColumnDefinition Width="8" />
         <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Content="{DynamicResource import}" Click="ImportClick" Padding="6,8" />
        <Button Grid.Column="2" Content="{DynamicResource export}" Click="ExportClick" Padding="6,8" />
       </Grid>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="TestPage" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
       <StackPanel>
        <TextBlock Text="{DynamicResource personalTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource personalIntro}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
        <TextBlock Text="{DynamicResource personalSteps}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14"/>
        <WrapPanel>
         <Button x:Name="PersonalCalibrateButton" Content="{DynamicResource personalStart}" Style="{StaticResource PrimaryButton}" Click="PersonalCalibrateClick" Margin="0,0,8,8"/>
         <Button x:Name="CancelPersonalButton" Content="{DynamicResource cancel}" Click="CancelPersonalCalibrationClick" IsEnabled="False" Margin="0,0,8,8"/>
         <Button x:Name="RestoreDeviceButton" Content="{DynamicResource personalRestoreDevice}" Click="RestoreDeviceSettingsClick" IsEnabled="False" Margin="0,0,0,8"/>
        </WrapPanel>
        <StackPanel x:Name="PersonalPhasePanel" Visibility="Visible">
         <TextBlock x:Name="PersonalInstruction" Text="{DynamicResource personalReady}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,8"/>
         <TextBlock x:Name="PersonalPhrase" Text="{DynamicResource personalPosition}" Style="{StaticResource BodyMuted}"/>
         <ProgressBar x:Name="PersonalProgress" Minimum="0" Maximum="20" Value="0" Margin="0,12,0,10" AutomationProperties.Name="{DynamicResource personalProgress}"/>
        </StackPanel>
        <StackPanel x:Name="PersonalResultPanel" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock x:Name="PersonalMeasurementText" Style="{StaticResource BodyMuted}" Margin="0,0,0,12"/>
         <TextBlock x:Name="PersonalWarnings" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
         <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource personalSetting}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{DynamicResource personalBefore}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="{DynamicResource personalAfter}" Style="{StaticResource Caption}"/></Grid>
         <ItemsControl x:Name="PersonalChanges"><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0"/>
           <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
           <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{DynamicResource personalLimit}" Style="{StaticResource BodyMuted}" Margin="0,8,0,14"/>
         <WrapPanel>
          <Button x:Name="ListenPersonalRawButton" Content="{DynamicResource listenRaw}" Click="ListenPersonalClick" IsEnabled="False" Margin="0,0,8,8"/>
          <Button x:Name="ListenPersonalButton" Content="{DynamicResource personalListen}" Click="ListenPersonalClick" IsEnabled="False" Margin="0,0,8,8"/>
          <Button x:Name="ApplyPersonalButton" Content="{DynamicResource personalApply}" Click="ApplyPersonalClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,0,8"/>
         </WrapPanel>
        </StackPanel>
        <Button x:Name="UndoPersonalButton" Content="{DynamicResource personalUndo}" Click="UndoPersonalClick" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
       <StackPanel>
        <TextBlock Text="{DynamicResource test}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
        <TextBlock Text="{DynamicResource testHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,14" />
        <WrapPanel>
         <Button x:Name="RecordButton" Content="{DynamicResource record}" Click="RecordClick" Margin="0,0,8,8" />
         <Button x:Name="ListenRawButton" Content="{DynamicResource listenRaw}" Click="ListenRawClick" IsEnabled="False" Margin="0,0,8,8" />
         <Button x:Name="ListenProcessedButton" Content="{DynamicResource listenProcessed}" Click="ListenProcessedClick" IsEnabled="False" Margin="0,0,8,8" />
         <Button x:Name="ExportWaveButton" Content="{DynamicResource exportWave}" Click="ExportWaveClick" IsEnabled="False" Margin="0,0,0,8" />
        </WrapPanel>
        <ProgressBar x:Name="SampleProgress" Minimum="0" Maximum="20" Value="0" Margin="0,6,0,10" AutomationProperties.Name="{DynamicResource sampleProgressName}" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
         </Grid.ColumnDefinitions>
         <Button x:Name="CalibrateButton" Content="{DynamicResource calibrate}" Click="CalibrateClick" Margin="0,0,14,0" />
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="CalibrationMessage" Text="{DynamicResource ambientPrompt}" Style="{StaticResource BodyMuted}" />
          <TextBlock Text="{DynamicResource headphones}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
         </StackPanel>
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="PreferencesPage" Visibility="Collapsed">
      <Border x:Name="GameSettingsPanel" Style="{StaticResource Panel}" Margin="0,0,0,18">
       <StackPanel>
        <TextBlock Text="{DynamicResource gameMode}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource gameIntro}" Style="{StaticResource BodyMuted}" Margin="0,0,0,16"/>
        <CheckBox x:Name="GameModeBox" Content="{DynamicResource gameAuto}" Checked="GameModeChanged" Unchecked="GameModeChanged" Margin="0,0,0,8"/>
        <CheckBox x:Name="EffectsBox" Content="{DynamicResource effectsEnable}" Checked="GameModeChanged" Unchecked="GameModeChanged" Margin="0,0,0,16"/>
        <Border Background="#222FAC91" CornerRadius="12" Padding="14"><TextBlock x:Name="GameModeDetail" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/></Border>
        <TextBlock Text="{DynamicResource gameProcesses}" Margin="0,20,0,8"/>
        <TextBox x:Name="GameProcessesBox" MaxLength="1940" AutomationProperties.Name="{DynamicResource gameProcesses}"/>
        <TextBlock Text="{DynamicResource gameProcessesHint}" Style="{StaticResource BodyMuted}" Margin="0,8,0,12"/>
        <Button Content="{DynamicResource gameSaveList}" Click="SaveGameProcesses" HorizontalAlignment="Left"/>
        <TextBlock Text="{DynamicResource gameDetectionHint}" Style="{StaticResource BodyMuted}" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
      <Border x:Name="CommunicationPanel" Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel>
       <TextBlock Text="{DynamicResource communicationTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="{DynamicResource communicationHint}" Style="{StaticResource BodyMuted}" Margin="0,0,0,12"/>
       <TextBlock Text="{DynamicResource talkMode}" Style="{StaticResource BodyMuted}" Margin="0,0,0,4"/>
       <ComboBox x:Name="TalkModeBox" AutomationProperties.Name="{DynamicResource talkMode}"><ComboBoxItem Content="{DynamicResource talkOpen}"/><ComboBoxItem Content="{DynamicResource talkPush}"/><ComboBoxItem Content="{DynamicResource talkMute}"/></ComboBox>
       <WrapPanel Margin="0,10,0,0"><TextBlock Text="{DynamicResource holdKey}" VerticalAlignment="Center"/><TextBlock Text="Ctrl+Alt+" VerticalAlignment="Center" Margin="6,0,0,0"/><ComboBox x:Name="HoldKeyBox" Width="65" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource holdKey}"/></WrapPanel>
        <WrapPanel Margin="0,10,0,0">
         <TextBlock Text="{DynamicResource muteKey}" VerticalAlignment="Center" />
         <ComboBox x:Name="MuteKeyBox" Width="65" Margin="6,0,16,0" AutomationProperties.Name="{DynamicResource muteKey}" />
         <TextBlock Text="{DynamicResource bypassKey}" VerticalAlignment="Center" />
         <ComboBox x:Name="BypassKeyBox" Width="65" Margin="6,0,16,0" AutomationProperties.Name="{DynamicResource bypassKey}" />

        </WrapPanel>
       <CheckBox x:Name="PresetKeysBox" Content="{DynamicResource presetKeys}" Margin="0,14,0,4"/>
       <TextBlock Text="{DynamicResource presetKeysHint}" Style="{StaticResource BodyMuted}"/>
       <Button Content="{DynamicResource applyKeys}" Click="ApplyKeysClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       </StackPanel></Border>
      <Expander Header="{DynamicResource preferences}" Margin="0,0,0,12">
       <StackPanel Margin="0,12,0,0">
        <CheckBox x:Name="StartupBox" Content="{DynamicResource startup}" Checked="StartupChanged" Unchecked="StartupChanged" />

       </StackPanel>
      </Expander>
      <TextBlock x:Name="DiagnosticsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource GlassChromeBrush}" CornerRadius="18" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" Padding="16,12" Margin="0,16,0,0">
   <StackPanel>
    <TextBlock x:Name="TalkStateText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel>
     <CheckBox x:Name="MuteBox" Content="{DynamicResource mute}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,12,6" />
     <CheckBox x:Name="BypassBox" Content="{DynamicResource bypass}" ToolTip="{DynamicResource bypassTip}" Checked="SettingsToggled" Unchecked="SettingsToggled" Margin="0,0,12,6" />
    </WrapPanel>
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="{DynamicResource ready}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Grid.Column="1" Text="{DynamicResource privacy}" Style="{StaticResource Caption}" Margin="16,0,0,0" />
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</Window>
