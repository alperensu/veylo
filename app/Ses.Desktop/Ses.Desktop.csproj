<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Veylo</AssemblyName><Product>Veylo</Product><Title>Veylo</Title><RootNamespace>Ses.Desktop</RootNamespace><Version>0.7.5-dev</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/veylo.ico</ApplicationIcon><EnableNETAnalyzers>true</EnableNETAnalyzers><AnalysisLevel>latest</AnalysisLevel>
    <NativeBinary Condition="'$(NativeBinary)' == ''">$(MSBuildThisFileDirectory)../../build/bin/ses_native.dll</NativeBinary>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Ses.Core/Ses.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Include="$(NativeBinary)" Link="ses_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="Assets/veylo.ico" Link="veylo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
